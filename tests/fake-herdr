#!/usr/bin/env python3
"""A stand-in for the Herdr CLI in tests.

Answers the commands snip uses from tests/fixtures and logs every call to
$FAKE_HERDR_LOG as one JSON list per line. Set FAKE_HERDR_FAIL to make
`agent prompt` fail the way Herdr does for an agent waiting on an approval.
"""
import json
import os
import sys
from pathlib import Path

FIXTURES = Path(__file__).resolve().parent / "fixtures"


def show(name):
    sys.stdout.write((FIXTURES / name).read_text(encoding="utf-8"))


def main():
    args = sys.argv[1:]
    if os.environ.get("FAKE_HERDR_LOG"):
        with open(os.environ["FAKE_HERDR_LOG"], "a", encoding="utf-8") as log:
            log.write(json.dumps(args) + "\n")
    cmd = args[:2]
    if cmd == ["agent", "list"]:
        show("agents.json")
    elif cmd == ["agent", "get"]:
        show("source.json")
    elif cmd == ["agent", "prompt"]:
        if os.environ.get("FAKE_HERDR_FAIL"):
            print(json.dumps({"error": {"code": "agent_blocked", "message": "agent is waiting on an approval"}}))
            sys.exit(1)
        print(json.dumps({"id": "cli:agent:prompt", "result": {"type": "prompt_submitted"}}))
    elif cmd == ["pane", "list"]:
        print(json.dumps({"result": {"panes": [{"pane_id": "w1:p1", "focused": True}]}}))
    elif cmd == ["pane", "read"]:
        show("screen.ansi")
    elif cmd == ["pane", "layout"]:
        show("layout.json")
    elif cmd == ["plugin", "config-dir"]:
        print(os.environ.get("SNIP_CONFIG_DIR", "/nonexistent"))
    elif cmd == ["plugin", "pane"]:
        print(json.dumps({"result": {"type": "plugin_pane_opened"}}))
    else:
        print(json.dumps({"error": {"message": "fake herdr: unsupported: " + " ".join(args)}}))
        sys.exit(2)


if __name__ == "__main__":
    main()
